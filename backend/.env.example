APP_NAME=PokkhoAI API
APP_ENV=development
LOG_LEVEL=INFO
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
MFA_ENCRYPTION_KEY=
# Runtime credentials must belong to app_user and be provisioned out of band.
DATABASE_URL=postgresql+asyncpg://app_user:REPLACE_ME@localhost:5432/legal_copilot
# Local Compose integration tests only; provision the app_user credential out of band.
TEST_DATABASE_URL=postgresql+asyncpg://app_user:REPLACE_ME@localhost:5432/legal_copilot
ALEMBIC_DATABASE_URL=postgresql+asyncpg://app_owner:REPLACE_ME@localhost:5432/legal_copilot
ALEMBIC_BOOTSTRAP_DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_ME@localhost:5432/legal_copilot
# Legal KB ingestion (python -m app.rag.ingest) writes only as app_admin_ingest.
LEGAL_INGEST_DATABASE_URL=postgresql+asyncpg://app_admin_ingest:REPLACE_ME@localhost:5432/legal_copilot
# Optional, opt-in: idempotency test writes undeletable SAMPLE_DATA_NOT_REAL_LAW rows.
LEGAL_INGEST_TEST_DATABASE_URL=

# LLM Configuration. Only providers approved in DOCS/providers.md may be listed.
# Gemini is disabled until its review record exists (synthetic data only).
LLM_PROVIDER=mock
LLM_APPROVED_PROVIDERS=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Object storage (local Compose MinIO). Keys are cases/{case_id}/documents/{document_id}.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=legal-copilot-dev
MINIO_SECURE=false
# Backblaze B2: MINIO_ENDPOINT=s3.<region>.backblazeb2.com MINIO_SECURE=true MINIO_REGION=<region>
MINIO_REGION=
TEST_MINIO_BUCKET=legal-copilot-test
# Malware scanner: none = not configured (dev warns, production refuses uploads).
MALWARE_SCANNER=none
OCR_LANGUAGES=ben+eng
# Fact extraction: mock (dev/test only) or ollama (local, see DOCS/providers.md).
# LLM_PROVIDER=ollama
# LLM_APPROVED_PROVIDERS=mock,ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=
# Gemini analysis/strategy: GEMINI_MODEL, then GEMINI_FALLBACK_MODEL after 429/503 retries, then the mock.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Embeddings: intfloat/multilingual-e5-small, ONNX int8, on this machine (no API key).
# Build the model bundle once: uv run python scripts/export_e5_small_onnx.py
# The knowledge base must be embedded with the same model (python -m app.rag.embed run),
# or search answers 503 EMBEDDING_MODEL_MISMATCH.
EMBEDDING_PROVIDER=e5_small_onnx
# E5_ONNX_DIR=models/multilingual-e5-small-onnx-int8
# E5_ONNX_THREADS=1
# Analysis abstain threshold; leave unset for the calibrated per-model default.
# ANALYSIS_MIN_SIMILARITY=
