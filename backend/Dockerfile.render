# Render FREE plan image (512 MB RAM): API only, no torch.
# Query embeddings come from the Gemini API (EMBEDDING_PROVIDER=gemini, gemini-embedding-001;
# the demo knowledge base is embedded with the same model), the database is Neon,
# documents go to Backblaze B2. See DOCS/deploy_render_free.md.
#
# Build locally:  docker build -f backend/Dockerfile.render -t pokkhoai-render backend
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    # Fewer glibc malloc arenas: less fragmentation on a 512 MB box.
    MALLOC_ARENA_MAX=2 \
    # Tesseract: one OpenMP thread (each thread holds its own buffers).
    OMP_THREAD_LIMIT=1 \
    EMBEDDING_PROVIDER=gemini \
    RERANKER_PROVIDER=mock \
    # OCR render cap: keeps a scanned A4 page + Tesseract under 450 MB (measured).
    OCR_DPI=250 \
    PORT=10000

# Tesseract with Bangla (+ English, which tesseract-ocr ships).
RUN apt-get update \
 && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-ben \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
# Runtime dependencies only: no `dev` (pytest, testcontainers) and no `ml` (torch, CUDA).
RUN uv sync --frozen --no-default-groups --no-install-project \
 && rm /usr/local/bin/uv \
 && ! python -c "import torch" 2>/dev/null

COPY app ./app

RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin app
USER app

EXPOSE 10000
# One worker keeps memory flat. Render sets $PORT and terminates TLS in its proxy,
# which is the only way to reach the container, so its X-Forwarded-For is trusted.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port \"$PORT\" --workers 1 --proxy-headers --forwarded-allow-ips '*' --no-server-header"]
