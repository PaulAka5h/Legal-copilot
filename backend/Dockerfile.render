# Render FREE plan image (512 MB RAM): API only, no torch.
# Query embeddings: intfloat/multilingual-e5-small as ONNX int8 on this CPU
# (EMBEDDING_PROVIDER=e5_small_onnx, 384 dims; the knowledge base is embedded with the
# same build). The database is Neon, documents go to Backblaze B2, the LLM is Gemini.
# See DOCS/deploy_render_free.md.
#
# Build locally:  docker build -f backend/Dockerfile.render -t pokkhoai-render backend

# --- Stage 1: build the e5-small ONNX int8 model from pinned inputs -----------------
# Downloads the pinned fp32 ONNX + tokenizer (SHA-256 checked), quantizes with the
# locked onnx/onnxruntime versions, and fails the build unless the result is the exact
# model the knowledge base was embedded with (E5_SMALL_MODEL_SHA256).
FROM python:3.12-slim AS e5-model
COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /usr/local/bin/uv
RUN uv pip install --system --no-cache numpy==2.5.5 protobuf==7.36.2 onnx==1.23.2 onnxruntime==1.32.0
COPY scripts/export_e5_small_onnx.py /build/export_e5_small_onnx.py
RUN python /build/export_e5_small_onnx.py --out /model \
      --expect-sha256 f5c0888fe75d7bd39d468b23417c8831247b70078ecc19e72041df3d86676842

# --- Stage 2: the API image ----------------------------------------------------------
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    # Fewer glibc malloc arenas: less fragmentation on a 512 MB box.
    MALLOC_ARENA_MAX=2 \
    # Tesseract: one OpenMP thread (each thread holds its own buffers).
    OMP_THREAD_LIMIT=1 \
    EMBEDDING_PROVIDER=e5_small_onnx \
    E5_ONNX_DIR=/app/models/multilingual-e5-small-onnx-int8 \
    # Load the query model at startup: its one-time load peak never meets an OCR upload.
    PRELOAD_QUERY_EMBEDDER=true \
    RERANKER_PROVIDER=mock \
    # OCR render cap: keeps a scanned A4 page + Tesseract under 450 MB (measured).
    OCR_DPI=250 \
    PORT=10000

# Tesseract with Bangla (+ English, which tesseract-ocr ships).
RUN apt-get update \
 && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-ben \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
# Runtime dependencies only: no `dev` (pytest, testcontainers) and no `ml` (torch, CUDA).
RUN uv sync --frozen --no-default-groups --no-install-project \
 && rm /usr/local/bin/uv \
 && ! python -c "import torch" 2>/dev/null

COPY app ./app
# Read-only model bundle; the app re-checks the model SHA-256 when it loads it.
COPY --from=e5-model /model ./models/multilingual-e5-small-onnx-int8

RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin app
USER app

EXPOSE 10000
# One worker keeps memory flat. Render sets $PORT and terminates TLS in its proxy,
# which is the only way to reach the container, so its X-Forwarded-For is trusted.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port \"$PORT\" --workers 1 --proxy-headers --forwarded-allow-ips '*' --no-server-header"]
