# FastAPI origin used by server components and server actions. Browser calls use
# the /api/v1 rewrite so session cookies remain on the frontend origin.
BACKEND_URL=http://127.0.0.1:8000
# Development-only mock sign-in. Never enable in production.
MOCK_AUTH=false

# Backend API (server-side only). APP_ORIGIN must match the backend's APP_ORIGIN (CSRF check).
BACKEND_API_URL=http://127.0.0.1:8000
APP_ORIGIN=http://localhost:3000
